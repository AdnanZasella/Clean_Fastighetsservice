---
// Fast balk längst ned på mobil: alltid ett tryck från att ringa eller begära offert.
import Icon from './Icon.astro';
import { primaryPhone } from '../data/business';
---

<div class="callbar" role="region" aria-label="Snabbkontakt">
  <a class="callbar__btn callbar__btn--call" href={primaryPhone.href}>
    <Icon name="phone" size={20} />
    Ring oss
  </a>
  <a class="callbar__btn callbar__btn--quote" href="/offert/">
    <Icon name="receipt" size={20} />
    Gratis offert
  </a>
</div>

<style>
  .callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 10px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    box-shadow: 0 -6px 20px rgb(13 33 68 / 0.08);
  }
  .callbar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    border-radius: var(--radius-sm);
    font-weight: 800;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .callbar__btn--call {
    background: var(--navy-700);
    color: #fff;
  }
  .callbar__btn--quote {
    background: var(--yellow);
    color: var(--navy-900);
  }
  @media (min-width: 960px) {
    .callbar {
      display: none;
    }
  }
</style>
