---
// "E&I"-märket från affischen, återskapat som text + SVG-bricka.
interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${variant}`]}>
  <span class="logo__mark">E&amp;I</span>
  <span class="logo__text">
    <strong>Bygg Service Fastighet</strong>
    <span>Städning AB</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1.1;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    height: 42px;
    padding-inline: 10px;
    border-radius: 10px;
    background: var(--navy-700);
    color: #fff;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    font-family: Georgia, 'Times New Roman', serif;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    color: var(--navy-900);
  }
  .logo__text strong {
    font-weight: 800;
  }
  .logo__text span {
    color: var(--muted);
    font-weight: 600;
  }
  .logo--light .logo__mark {
    background: #fff;
    color: var(--navy-700);
  }
  .logo--light .logo__text,
  .logo--light .logo__text span {
    color: #fff;
  }
  @media (max-width: 360px) {
    .logo__text {
      display: none;
    }
  }
</style>
