---
import Icon from './Icon.astro';
import { primaryPhone, business } from '../data/business';

interface Props {
  title?: string;
  text?: string;
}
const { title = 'Vill du ha ett pris?', text = `Berätta vad du behöver, så hör vi av oss ${business.responseTime}.` } =
  Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div>
      <a class="btn btn--primary" href="/offert/">Få gratis offert <Icon name="arrow" /></a>
      <a class="call-link" href={primaryPhone.href}>eller ring {primaryPhone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--navy-700);
    color: #fff;
    padding-block: 52px;
  }
  .cta__inner {
    display: grid;
    gap: 24px;
  }
  .cta h2 {
    color: #fff;
  }
  .cta p {
    color: #d3dff0;
    margin: 0;
  }
  .cta .call-link {
    color: #fff;
  }
  @media (min-width: 960px) {
    .cta {
      padding-block: 72px;
    }
    .cta__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 48px;
    }
  }
</style>
